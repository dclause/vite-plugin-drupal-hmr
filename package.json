{
  "name": "vite-plugin-drupal-hmr",
  "version": "1.1.0",
  "description": "A Vite plugin to enhance Drupal development with HMR.",
  "keywords": [
    "vite",
    "vite-plugin",
    "hmr",
    "drupal",
    "twig"
  ],
  "author": "Dominique Clause <dom.clause@gmail.com>",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/dclause/vite-plugin-drupal-hmr",
  "repository": {
    "type": "git",
    "url": "https://github.com/dclause/vite-plugin-drupal-hmr"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build",
    "fix": "prettier --write . && eslint --fix ."
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.10",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.1.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^7.3.1"
  }
}
